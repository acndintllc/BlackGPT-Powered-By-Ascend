# generate a random secret: https://generate-secret.vercel.app/32 or `openssl rand -base64 32`
AUTH_SECRET=****

# required for non-vercel deployments, vercel uses OIDC automatically
# used by the remaining gateway-routed models
# https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=****

# OpenAI-compatible proxy used for the default Qwen model.
# AI_PROXY_API_KEY is required; the other two have defaults.
AI_PROXY_API_KEY=****
# defaults to https://dashscope-intl.aliyuncs.com/compatible-mode/v1
AI_PROXY_BASE_URL=
# upstream model id sent to the proxy, defaults to qwen3.8-max
QWEN_MODEL_ID=

# https://vercel.com/docs/vercel-blob
BLOB_READ_WRITE_TOKEN=****

# https://vercel.com/docs/postgres
POSTGRES_URL=****

# https://vercel.com/docs/redis
REDIS_URL=****

# public origin used for metadata, defaults to https://blackgpt.ai
NEXT_PUBLIC_APP_URL=
